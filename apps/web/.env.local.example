# Copy to .env.local and fill in. Never commit the real .env.local.
# Only needed when running the frontend natively (npm run dev) against
# Keycloak started via `docker compose up -d` — if you run the whole stack
# with docker compose, these all come from the root .env file instead.

AUTH_SECRET=                      # generate with: npx auth secret
AUTH_KEYCLOAK_ID=selection-system-web
AUTH_KEYCLOAK_SECRET=dev-web-client-secret-change-me
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/pnc-selection

# Only needed if AUTH_KEYCLOAK_ISSUER above points at a Docker-internal
# address (e.g. http://keycloak:8080/...) and the browser needs a different,
# publicly reachable address to reach Keycloak's login page. Not needed here
# since both addresses are the same localhost one in native dev.
# AUTH_KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/pnc-selection
