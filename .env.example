# Copy to .env and adjust as needed. `docker compose` reads this file
# automatically (same directory as docker-compose.yml). Never put real
# secrets in .env.example — only safe, documented dev defaults.
#
# These values are also the single source of truth that docker-compose.yml
# forwards into the backend and frontend containers, so changing a value
# here (e.g. KEYCLOAK_WEB_CLIENT_SECRET) is the only place it needs to change.

# ── Keycloak ─────────────────────────────────────────────────────────────
KEYCLOAK_REALM=pnc-selection
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Two addresses for the same Keycloak instance:
#   PUBLIC_URL   - what the browser uses (the published port on the host)
#   INTERNAL_URL - what the backend/frontend containers use (Docker service
#                  DNS) to reach Keycloak without going back out through the
#                  host network
# If you change KEYCLOAK_PORT, update KEYCLOAK_PUBLIC_URL to match.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# Must match infra/keycloak/realm-export.json's clientId/secret/redirect URIs.
KEYCLOAK_API_CLIENT_ID=selection-system-api
KEYCLOAK_WEB_CLIENT_ID=selection-system-web
KEYCLOAK_WEB_CLIENT_SECRET=dev-web-client-secret-change-me

# ── Backend (ASP.NET Core Host) ─────────────────────────────────────────
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# ── Frontend (Next.js) ───────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000
# Generate a real one with: npx auth secret
AUTH_SECRET=dev-secret-change-me-run-npx-auth-secret
