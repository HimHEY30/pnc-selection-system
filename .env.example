# Copy to .env and adjust as needed. `docker compose` reads this file
# automatically (same directory as docker-compose.yml). Never put real
# secrets in .env.example — only safe, documented dev defaults.
#
# These values are also the single source of truth that docker-compose.yml
# forwards into the backend and frontend containers, so changing a value
# here (e.g. KEYCLOAK_WEB_CLIENT_SECRET) is the only place it needs to change.

# ── Keycloak ─────────────────────────────────────────────────────────────
KEYCLOAK_REALM=pnc-selection
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Two addresses for the same Keycloak instance:
#   PUBLIC_URL   - what the browser uses (the published port on the host)
#   INTERNAL_URL - what the backend/frontend containers use (Docker service
#                  DNS) to reach Keycloak without going back out through the
#                  host network
# If you change KEYCLOAK_PORT, update KEYCLOAK_PUBLIC_URL to match.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# Must match infra/keycloak/realm-export.json's clientId/secret/redirect URIs.
KEYCLOAK_API_CLIENT_ID=selection-system-api
KEYCLOAK_WEB_CLIENT_ID=selection-system-web
KEYCLOAK_WEB_CLIENT_SECRET=dev-web-client-secret-change-me

# The backend's read-only client for listing staff (information sessions are assigned to
# them). Also in infra/keycloak/realm-export.json. Change the secret for anything beyond local dev.
KEYCLOAK_STAFF_CLIENT_ID=selection-system-staff-reader
KEYCLOAK_STAFF_CLIENT_SECRET=dev-staff-client-secret-change-me

# ── Email / SMTP (forgot-password) ──────────────────────────────────────
# Mailpit is a local fake SMTP server + web inbox (see docker-compose.yml) -
# no real email account or secret needed for dev. Keycloak's password-reset
# emails land at http://localhost:${MAILPIT_UI_PORT} instead of a real inbox.
# Must match infra/keycloak/realm-export.json's smtpServer block (that file
# has no env-var substitution, same convention as KEYCLOAK_WEB_CLIENT_SECRET
# above) - if you change these, also update it and re-apply via the admin
# API (see features/keycloak-forgot-password-email/README.md).
# To point at a REAL SMTP provider instead, replace SMTP_HOST/PORT and set
# SMTP_AUTH=true with real SMTP_USER/SMTP_PASSWORD - never commit real
# credentials here.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@pnc-ssms.local
SMTP_FROM_DISPLAY_NAME=PNC Selection System
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false

# ── Application database (campaigns, ...) ───────────────────────────────
# Separate from the Keycloak database above. The port is published so you can
# run the backend from your IDE (appsettings.Development.json points at 5433)
# and connect with psql. Change the password for anything beyond local dev.
SSMS_DB_NAME=ssms
SSMS_DB_USER=ssms
SSMS_DB_PASSWORD=ssms
SSMS_DB_PORT=5433

# ── Backend (ASP.NET Core Host) ─────────────────────────────────────────
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
# true = create three sample campaigns when the database has none. Off by
# default so a fresh install shows the "No campaign yet" screen.
SEED_DEMO_CAMPAIGNS=false

# ── Frontend (Next.js) ───────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000
# Generate a real one with: npx auth secret
AUTH_SECRET=dev-secret-change-me-run-npx-auth-secret
